# Local npm run dev connection; URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://cacsms:replace-with-url-encoded-password@localhost:5432/db_cacsms-sports
POSTGRES_PASSWORD=replace-with-long-random-secret
# PAPER mode is hardcoded; no paid-wager capability is shipped.
SPORTS_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Comma-separated hostnames of sources with explicit browser automation permission.
SPORTS_BROWSER_ALLOWED_HOSTS=

# Optional, explicit authorized vision provider. Do not commit credentials.
SPORTS_VISION_ENDPOINT=
SPORTS_VISION_MODEL=
SPORTS_VISION_API_KEY=
SPORTS_VISION_ALLOWED_HOSTS=

# Autonomous fixture discovery: map registered authorized source IDs to public HTTPS JSON feed URLs.
SPORTS_DISCOVERY_FEEDS_JSON={}
# Existing research feeds map source IDs to section-specific public HTTPS URLs.
SPORTS_SOURCE_FEEDS_JSON={}

# Optional open-data fixture discovery. Data attribution and ODbL terms apply.
SPORTS_OPENLIGADB_ENABLED=0
# Optional app identification for this provider; do not include secrets.
SPORTS_OPENLIGADB_USER_AGENT=CACSMS-Sports/1.0 (local research dashboard)

# Research auto-verification requires agreement from independently reviewed source groups.
# Example structure: {"source-uuid":{"reviewed":true,"independence_group":"provider-a"}}
SPORTS_RESEARCH_QUORUM_JSON={}
# Optional research dimensions without corroborated evidence are marked UNAVAILABLE this many minutes before kickoff.
SPORTS_RESEARCH_DEADLINE_MINUTES=60
# Maximum out-of-sample expected calibration error allowed when promoting a challenger model.
SPORTS_MODEL_MAX_ECE=0.08
