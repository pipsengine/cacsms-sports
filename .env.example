# Local npm run dev connection; URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg://cacsms:replace-with-url-encoded-password@localhost:5432/db_cacsms-sports
POSTGRES_PASSWORD=replace-with-long-random-secret
# PAPER mode is hardcoded; no paid-wager capability is shipped.
SPORTS_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Comma-separated hostnames of sources with explicit browser automation permission.
SPORTS_BROWSER_ALLOWED_HOSTS=

# Optional, explicit authorized vision provider. Do not commit credentials.
SPORTS_VISION_ENDPOINT=
SPORTS_VISION_MODEL=
SPORTS_VISION_API_KEY=
SPORTS_VISION_ALLOWED_HOSTS=

# Autonomous fixture discovery: map registered authorized source IDs to public HTTPS JSON feed URLs.
SPORTS_DISCOVERY_FEEDS_JSON={}
# Existing research feeds map source IDs to section-specific public HTTPS URLs.
SPORTS_SOURCE_FEEDS_JSON={}

# Optional open-data fixture discovery. Data attribution and ODbL terms apply.
SPORTS_OPENLIGADB_ENABLED=1
# Set a meaningful app identifier and contact URL or email before enabling this provider; do not include secrets.
SPORTS_OPENLIGADB_USER_AGENT=CACSMS-Sports/1.0 (local research dashboard)
# Football-Data.co.uk is prohibited for this autonomous application without written permission.
SPORTS_FOOTBALL_DATA_ENABLED=0
# Past seasons of corroborated history used for research and model training (1-8).
SPORTS_HISTORY_SEASONS=4
# Sources whose terms prohibit automated access (e.g. BetExplorer) are blocked unless express written consent is recorded:
# SPORTS_SOURCE_CONSENT=betexplorer.com=<written consent reference>
SPORTS_SOURCE_CONSENT=

# Two-provider league-window corroboration (outside the Bundesliga). Evidence is emitted only when two
# independent providers' complete league results produce identical form/scoring/H2H computations.
SPORTS_WINDOW_CORROBORATION_ENABLED=1
# API-Football (https://www.api-football.com). The plan must cover the current season; free plans may not.
SPORTS_APIFOOTBALL_KEY=
# Optional extra leagues: {"Name|Country":{"apifootball":144,"betexplorer":"football/belgium/jupiler-pro-league","calendar":false}}
SPORTS_CORROBORATION_LEAGUES_JSON={}
# Optional team-name aliases: {"betexplorer":{"Royale Union SG":"Union Saint-Gilloise"},"apifootball":{}}
SPORTS_TEAM_ALIASES_JSON={}

# Research auto-verification requires agreement from independently reviewed source groups.
# Example structure: {"source-uuid":{"reviewed":true,"independence_group":"provider-a"}}
SPORTS_RESEARCH_QUORUM_JSON={}
# Optional research dimensions without corroborated evidence are marked UNAVAILABLE this many minutes before kickoff.
SPORTS_RESEARCH_DEADLINE_MINUTES=60
# Maximum out-of-sample expected calibration error allowed when promoting a challenger model.
SPORTS_MODEL_MAX_ECE=0.08
# Keep API file watching off for uninterrupted local operation. Restart after Python changes.
SPORTS_API_RELOAD=0

# Optional public CDN hosts for subresources only; never grants navigation or source authorization.
SPORTS_BROWSER_SUBRESOURCE_HOSTS=

# Durable fixture discovery. The public SportsDB key is development-only.
SPORTS_FIXTURE_DISCOVERY_ENABLED=1
SPORTS_THESPORTSDB_ENABLED=1
SPORTS_THESPORTSDB_KEY=123
SPORTS_DEPLOYMENT_ENV=development
SPORTS_FIXTURE_HORIZON_DAYS=7
SPORTS_FIXTURE_JOBS_PER_CYCLE=4
